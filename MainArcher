<!DOCTYPE html>
<html lang="en-us">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ragdoll Archers (Cloud Save)</title>

<!-- Unity Loader -->
<script src="https://cdn.jsdelivr.net/gh/laparda14/Ragdoll-archers@62504c9570ea720c6367e7debe1e110c68f77c2d/vs/gameloader-helper.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/bubbls/ruffle@04dd5345a30d6ebf4b0e2cc385568750cd56ed5a/styyyle.css">

<!-- Firebase -->
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
</head>

<body>
<div id="unity-container">
  <canvas id="unity-canvas"></canvas>
</div>

<div id="loading-cover">
  <div id="unity-loading-bar">
    <div id="unity-logo">
      <img src="https://dummyimage.com/200x80/000/fff&text=Loading">
    </div>
    <div id="unity-progress-bar-empty">
      <div id="unity-progress-bar-full"></div>
    </div>
  </div>
</div>

<script>
// ----------------------
// 🔥 FIREBASE CONFIG (REPLACE THIS)
// ----------------------
const firebaseConfig = {
  apiKey: "PASTE_YOURS",
  authDomain: "PASTE_YOURS",
  databaseURL: "PASTE_YOURS",
  projectId: "PASTE_YOURS",
  storageBucket: "PASTE_YOURS",
  messagingSenderId: "PASTE_YOURS",
  appId: "PASTE_YOURS"
};

firebase.initializeApp(firebaseConfig);
const db = firebase.database();

// ----------------------
// 🔐 LOGIN
// ----------------------
let userId = null;

firebase.auth().signInAnonymously()
.then(() => {
  userId = firebase.auth().currentUser.uid;
  console.log("Logged in:", userId);
})
.catch(console.error);

// ----------------------
// 💾 SAVE
// ----------------------
function saveGameData(data) {
  if (!userId) return;

  db.ref("saves/" + userId).set({
    data: data,
    updated: Date.now()
  });

  console.log("Saved:", data);
}

// ----------------------
// 📂 LOAD
// ----------------------
function loadGameData(callback) {
  if (!userId) return;

  db.ref("saves/" + userId).once("value")
  .then(snapshot => {
    const val = snapshot.val();
    if (val && val.data) {
      console.log("Loaded:", val.data);
      callback(val.data);
    } else {
      callback(null);
    }
  });
}

// Make callable from Unity
window.saveGameData = saveGameData;

// ----------------------
// UNITY LOAD
// ----------------------
const loaderUrl = "https://cdn.jsdelivr.net/gh/bubbls/ruffle@7117cc5006472d782b65d96abd375597d6273242/v11121212.js";

const config = {
  dataUrl: "https://cdn.jsdelivr.net/gh/bubbls/ruffle@04dd5345a30d6ebf4b0e2cc385568750cd56ed5a/6697b6deba8b617c67b69c55dcd07cb1.data.unityweb",
  frameworkUrl: "https://cdn.jsdelivr.net/gh/bubbls/ruffle@04dd5345a30d6ebf4b0e2cc385568750cd56ed5a/0be3c3ee7115b26e1ae28e643afdf1f2.js.unityweb",
  codeUrl: "https://cdn.jsdelivr.net/gh/bubbls/ruffle@04dd5345a30d6ebf4b0e2cc385568750cd56ed5a/b3397c29f6878557c1c614cbf9e196ea.wasm.unityweb"
};

const canvas = document.querySelector("#unity-canvas");
const progressBarFull = document.querySelector("#unity-progress-bar-full");

const unityLoader = document.createElement("script");
unityLoader.src = loaderUrl;

unityLoader.onload = () => {
  createUnityInstance(canvas, config, (progress) => {
    progressBarFull.style.width = (progress * 100) + "%";
  }).then((unityInstance) => {

    window.unityInstance = unityInstance;

    // Load save into game
    loadGameData((saved) => {
      if (saved) {
        try {
          unityInstance.SendMessage("GameManager", "LoadGame", JSON.stringify(saved));
        } catch {
          console.log("Game doesn't support loading");
        }
      }
    });

  }).catch(alert);
};

document.body.appendChild(unityLoader);

// ----------------------
// AUTO SAVE (TEMP DATA)
// ----------------------
setInterval(() => {
  if (!window.unityInstance) return;

  const demoData = {
    coins: Math.floor(Math.random() * 1000),
    level: 1
  };

  saveGameData(demoData);

}, 20000);

// Focus fix
document.addEventListener("pointerdown", () => {
  canvas.focus();
});
</script>

</body>
</html>
